# ===============================================================
# Smart Cane - Root Git Ignore Rules
# ===============================================================

# --- Environment & Secret Configuration ---
.env
.env*.local
*.env
!.env.example

# --- Node.js & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Expo & Mobile App Artifacts ---
.expo/
.expo-shared/
web-build/
.metro-health-check*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- Python & ML Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/

# --- Temporary Bug Files & Archives ---
bugs_extracted/
*.zip
*.tar
*.gz
*.rar
*.7z

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- Logs & Runtime Data ---
*.log
logs/
*.pid
*.seed
*.pid.lock

