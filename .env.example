# ===============================================================
# Smart Cane - Environment Template (.env.example)
# Copy this file to .env and customize with your credentials
# ===============================================================

# --- Backend API (Node.js & Express) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_cane
JWT_SECRET=your_jwt_secret_key_here

# --- Machine Learning Service (FastAPI & Scikit-Learn) ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_PORT=8000
ML_HOST=0.0.0.0

# --- Live Weather Integration (OpenWeatherMap API) ---
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Mobile App Configuration (Expo) ---
EXPO_PUBLIC_API_URL=https://your-ngrok-or-production-url.ngrok-free.dev
EXPO_PUBLIC_API_HOST=your_local_ip_address_here

